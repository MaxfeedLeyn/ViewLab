@{
    ViewData["Title"] = "ShoppingCart";
    var dates = (List<DateTime>)ViewBag.Dates;
}

<!DOCTYPE html>

@using (Html.BeginForm("ShoppingCart", "Tasks", FormMethod.Post))
{
    <p>Input your fullname:</p>
    @Html.TextBox("fullName")

    <p>Input your address :</p>
    @Html.TextBox("address")

    <br /><br />
    @Html.DropDownList("market", (SelectList)ViewBag.Markets)

    <br /><br />
    @for (int i = 0; i < dates.Count; i++)
    {
        <div>
            @Html.RadioButton("shipDate", dates[i], i == 0) @dates[i]
        </div>
    }

    <br />
    @Html.ListBox("products", (MultiSelectList)ViewBag.Products)

    <br /><br />
    <input type="submit" value="Send" />
}